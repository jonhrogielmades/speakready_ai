# Render Environment Blueprint for SpeakReady AI
# Copy these keys into Render's Environment tab or an Environment Group.
# Replace every <...> value in Render. Do not commit real secrets.

APP_NAME="SpeakReady AI"
APP_ENV=production
APP_KEY=<generate_once_with_php_artisan_key_generate_show>
APP_DEBUG=false
APP_URL=https://<your-render-service>.onrender.com
ASSET_URL=
PORT=10000

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_EMERGENCY_PATH=php://stderr

DB_CONNECTION=pgsql
DATABASE_URL=<render-postgres-internal-or-external-database-url>
DB_SSLMODE=require
RENDER_POSTGRES_REGION=singapore

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=<your-render-service>.onrender.com
BCRYPT_ROUNDS=12

ADMIN_EMAIL=<admin-email>
ADMIN_NAME=<admin-name>
ADMIN_PASSWORD=<strong-initial-admin-password>

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=<verified-sender-email>
MAIL_FROM_NAME="SpeakReady AI"
MAIL_TIMEOUT=10

BREVO_API_KEY=<optional-brevo-api-key>
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_API_TIMEOUT=15

MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net
POSTMARK_TOKEN=

GOOGLE_CLIENT_ID=<optional-google-client-id>
GOOGLE_CLIENT_SECRET=<optional-google-client-secret>
GOOGLE_REDIRECT_URI=https://<your-render-service>.onrender.com/auth/google/callback
GOOGLE_HTTP_CONNECT_TIMEOUT=3
GOOGLE_HTTP_TIMEOUT=8

AI_PROVIDER=openai
INTERVIEW_CHATBOT_DEFAULT_PROVIDER=openai
AI_DEFAULT_PROVIDER_PRIORITY=openai,gemini,groq,cohere
INTERVIEW_CHATBOT_PROVIDER_PRIORITY=openai,gemini,groq,cohere
AI_FEEDBACK_PROVIDER_PRIORITY=openai,gemini,groq,cohere
AI_ATTACHMENT_EXTRACTION_PROVIDER_PRIORITY=openai,gemini
AI_ATTACHMENT_EXTRACTION_MAX_BYTES=5242880
AI_ATTACHMENT_EXTRACTION_MAX_TOKENS=2048
AI_ATTACHMENT_EXTRACTION_RESPONSE_CHARS=8000

OPENAI_API_KEY=<openai-api-key>
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_FEEDBACK_MODEL=gpt-4o-mini
OPENAI_JSON_MODE_FALLBACK=true

GEMINI_API_KEY=<optional-gemini-api-key>
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.6-flash

GROQ_API_KEY=<optional-groq-api-key>
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

COHERE_API_KEY=<optional-cohere-api-key>
COHERE_API_URL=https://api.cohere.com/v2/chat
COHERE_MODEL=command-r7b-12-2024

AI_FEEDBACK_TIMEOUT=15
AI_FEEDBACK_DEADLINE_SECONDS=25
AI_FEEDBACK_MAX_PROVIDERS=6
AI_FEEDBACK_ATTEMPTS=1
AI_FEEDBACK_HTTP_ATTEMPTS=1
AI_FEEDBACK_RETRY_DELAY_MS=200
AI_VOICE_ANALYSIS_TIMEOUT=12
AI_VOICE_ANALYSIS_MAX_PROVIDERS=2
AI_VOICE_ANALYSIS_HTTP_ATTEMPTS=1
AI_PROVIDER_TIMEOUT=45
AI_PROVIDER_CONNECT_TIMEOUT=5
AI_PROVIDER_RETRIES=2
AI_PROVIDER_RETRY_DELAY_MS=250
AI_PROVIDER_EVALUATION_TIMEOUT=10
AI_JSON_MAX_TOKENS=4096
AI_CHAT_MAX_TOKENS=1000
AI_GAME_BATCH_SIZE=5

AI_TTS_ENABLED=false
AI_TTS_PROVIDER=openai
AI_TTS_TIMEOUT=30
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_TTS_SPEED=0.95
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore
GEMINI_TTS_STYLE="Say in a warm, clear, professional interviewer voice with natural English pronunciation and steady pacing"
ELEVENLABS_API_KEY=<optional-elevenlabs-api-key>
ELEVENLABS_API_URL=https://api.elevenlabs.io/v1
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_TTS_VOICE_ID=<optional-elevenlabs-voice-id>
ELEVENLABS_TTS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_TTS_LANGUAGE_CODE=
ELEVENLABS_TTS_STABILITY=0.45
ELEVENLABS_TTS_SIMILARITY_BOOST=0.75
ELEVENLABS_TTS_STYLE=0.15
ELEVENLABS_TTS_SPEAKER_BOOST=true

AI_TRANSCRIPTION_PROVIDER_PRIORITY=openai,gemini
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
GEMINI_TRANSCRIPTION_MODEL=gemini-3.6-flash
AI_TRANSCRIPTION_TIMEOUT=45
AI_TRANSCRIPTION_CHUNK_MS=1200
AI_TRANSCRIPTION_MOBILE_CHUNK_MS=1500
AI_TRANSCRIPTION_DRAIN_TIMEOUT_MS=20000
AI_TRANSCRIPTION_REQUEST_TIMEOUT_MS=30000
AI_TRANSCRIPTION_MAX_IN_FLIGHT=2
AI_TRANSCRIPTION_RATE_LIMIT_COOLDOWN_SECONDS=90

LOCAL_SPEECH_ENABLED=false
LOCAL_SPEECH_PYTHON=python3
LOCAL_SPEECH_SCRIPT=scripts/local_speech_assess.py
LOCAL_SPEECH_TIMEOUT=90
LOCAL_ASR_BACKEND=whisper
LOCAL_ASR_MODEL=base
LOCAL_ASR_DEVICE=auto
LOCAL_PRONUNCIATION_BACKEND=ctc
LOCAL_PRONUNCIATION_MODEL=facebook/wav2vec2-base-960h
LOCAL_ALIGNMENT_BACKEND=mfa
MFA_COMMAND=mfa
MFA_DICTIONARY=
MFA_ACOUSTIC_MODEL=
FFMPEG_COMMAND=ffmpeg
LOCAL_GOP_BACKEND=mfa
LOCAL_GOP_COMMAND=

LOCAL_FEEDBACK_MODEL_ENABLED=false
LOCAL_FEEDBACK_MODEL_PYTHON=python3
LOCAL_FEEDBACK_MODEL_TRAIN_SCRIPT=scripts/train_feedback_model.py
LOCAL_FEEDBACK_MODEL_PREDICT_SCRIPT=scripts/predict_feedback.py
LOCAL_FEEDBACK_MODEL_PATH=storage/app/private/models/feedback/latest/model.json
LOCAL_FEEDBACK_MODEL_TIMEOUT=20
LOCAL_FEEDBACK_MODEL_TRAINING_TIMEOUT=300
LOCAL_FEEDBACK_MODEL_AUTO_TRAIN=false
LOCAL_FEEDBACK_MODEL_AUTO_TRAIN_TIME=02:30
LOCAL_FEEDBACK_MODEL_AUTO_TRAIN_DATASET=normalized/training/feedback_train.jsonl
LOCAL_FEEDBACK_MODEL_AUTO_TRAIN_STATUSES=approved,archived
LOCAL_FEEDBACK_MODEL_AUTO_TRAIN_MIN_EXAMPLES=100
LOCAL_FEEDBACK_MODEL_AUTO_TRAIN_EPOCHS=80

QUESTION_RECOMMENDER_ENABLED=false
QUESTION_RECOMMENDER_PYTHON=python3
QUESTION_RECOMMENDER_SCRIPT=scripts/recommend_interview_question.py
QUESTION_RERANK_SCRIPT=scripts/rerank_question_candidates.py
QUESTION_RERANK_SERVER_SCRIPT=scripts/serve_question_reranker.py
QUESTION_RERANK_SERVER_ENABLED=false
QUESTION_RERANK_ENDPOINT=http://127.0.0.1:8765/rerank
QUESTION_RERANK_SERVER_HOST=127.0.0.1
QUESTION_RERANK_SERVER_PORT=8765
QUESTION_RERANK_SERVER_TIMEOUT=2
QUESTION_EMBEDDING_INDEX_PATH=storage/app/private/datasets/embeddings/questions/latest/question_embeddings.json
QUESTION_EMBEDDING_BACKEND=lexical_hash
QUESTION_EMBEDDING_BUILD_TIMEOUT=120
QUESTION_RECOMMENDER_TIMEOUT=120
QUESTION_TRAINED_MODEL_ENABLED=false
QUESTION_TRAINED_MODEL_PATH=storage/app/private/models/questions/latest/trained_model
QUESTION_TRAINED_MODEL_LABEL_MAP_PATH=storage/app/private/models/questions/latest/trained_model/speakready_question_labels.json
QUESTION_TRAINED_MODEL_TIMEOUT=120
QUESTION_TRAINED_MODEL_PROCESS_FALLBACK=false
QUESTION_AI_PROVIDER_RERANK_ENABLED=true
QUESTION_AI_PROVIDER_RERANK_TIMEOUT=8
QUESTION_AI_PROVIDER_RERANK_ATTEMPTS=1
QUESTION_AI_PROVIDER_RERANK_CANDIDATE_LIMIT=18
QUESTION_AI_PROVIDER_RERANK_PRIORITY=openai,gemini,groq,cohere
QUESTION_RECOMMENDER_CANDIDATE_POOL_LIMIT=120
QUESTION_RECOMMENDER_CANDIDATE_POOL_MULTIPLIER=8
QUESTION_GENERATION_RAG_ENABLED=true
QUESTION_GENERATION_RAG_EXAMPLE_LIMIT=6

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1
VITE_APP_NAME="SpeakReady AI"
VITE_PUSHER_APP_KEY=
VITE_PUSHER_HOST=
VITE_PUSHER_PORT=443
VITE_PUSHER_SCHEME=https
VITE_PUSHER_APP_CLUSTER=mt1

REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_USERNAME=
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

RENDER_REPAIR_FEEDBACK_ON_START=false
RENDER_REPAIR_FEEDBACK_LIMIT=250
RUN_RENDER_DATA_CLEANUP=false
