APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# Render Postgres production example:
# Set DATABASE_URL to the full Internal Database URL from the Render database
# when the web service and database are in the same Render account and region.
# If they are not in the same region, use the full External Database URL instead.
# Do not set DB_HOST to only a partial Render host such as dpg-...-a.
# DB_CONNECTION=pgsql
# DATABASE_URL=postgresql://user:password@host:5432/database
# DB_SSLMODE=require
# RENDER_POSTGRES_REGION=singapore

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Free browser Web Speech APIs are used first for interview voice.
# Set AI_TTS_ENABLED=true only if you want server-generated OpenAI voice audio.
# OPENAI_TRANSCRIPTION_MODEL is used as the live transcription fallback when an OpenAI key is configured.
AI_TTS_ENABLED=false
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_TTS_SPEED=0.95
AI_TTS_TIMEOUT=30
OPENAI_TRANSCRIPTION_MODEL=whisper-1
AI_TRANSCRIPTION_TIMEOUT=30

# Keep final interview feedback responsive. Evidence-grounded local scoring is
# used immediately if the selected provider is unavailable or incomplete.
OPENAI_FEEDBACK_MODEL=gpt-4o-mini
OPENAI_JSON_MODE_FALLBACK=true
AI_FEEDBACK_TIMEOUT=15
AI_FEEDBACK_MAX_PROVIDERS=1
AI_FEEDBACK_ATTEMPTS=1
AI_FEEDBACK_HTTP_ATTEMPTS=1
AI_FEEDBACK_RETRY_DELAY_MS=200
AI_PROVIDER_CONNECT_TIMEOUT=5
