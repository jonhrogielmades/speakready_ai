# Dokploy production template for https://speakreadyai.online
APP_NAME="SpeakReady AI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://speakreadyai.online
ASSET_URL=
PORT=80

# Generate APP_KEY once and keep it stable:
# php artisan key:generate --show

LOG_CHANNEL=stderr
LOG_EMERGENCY_PATH=php://stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=speakready_ai
DB_USERNAME=speakready
DB_PASSWORD=
DATABASE_URL=
MYSQL_ROOT_PASSWORD=

# PostgreSQL production example:
# If you use an external PostgreSQL database instead of the compose MariaDB service,
# set DATABASE_URL to the full database URL from your hosting provider.
# DB_CONNECTION=pgsql
# DATABASE_URL=postgresql://user:password@host:5432/database
# DB_SSLMODE=require

BROADCAST_DRIVER=log
CACHE_DRIVER=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_AFTER_COMMIT=true
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=speakreadyai.online
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=speakreadyai.online
CORS_ALLOWED_ORIGINS=https://speakreadyai.online
CORS_SUPPORTS_CREDENTIALS=true

# Startup controls. Container startup remains behind maintenance mode if a
# required step fails. DatabaseSeeder only runs the idempotent admin seeder.
RUN_MIGRATIONS_ON_START=true
RUN_SCHEMA_REPAIRS_ON_START=true
RUN_SCHEDULER_ON_START=true
RUN_SCHEMA_REPAIRS_ON_REQUEST=false
STARTUP_MAINTENANCE_FAIL_OPEN=false
RUN_DATABASE_SEEDERS=false
TRUSTED_PROXIES=REMOTE_ADDR
AUTH_RATE_LIMIT_PER_MINUTE=10
AUTH_GENERIC_LOGIN_ERRORS=true
AI_RATE_LIMIT_PER_MINUTE=20
AI_EXPENSIVE_RATE_LIMIT_PER_MINUTE=6
AI_TRANSCRIBE_RATE_LIMIT_PER_MINUTE=20
ADMIN_AI_RATE_LIMIT_PER_MINUTE=5
CONTACT_RATE_LIMIT_PER_MINUTE=3
PUSH_RATE_LIMIT_PER_MINUTE=20
PRIVACY_PRUNE_TIME=03:15
REPAIR_FEEDBACK_ON_START=false
REPAIR_FEEDBACK_LIMIT=250

# Required on the first production startup when RUN_DATABASE_SEEDERS=true.
# Used only to bootstrap a new/missing admin password. Later password changes
# are preserved when startup seeding runs again.
ADMIN_NAME="System Admin"
ADMIN_EMAIL=capstonespeakreadyai@gmail.com
ADMIN_PASSWORD=
ADMIN_EMAIL_NOTIFICATIONS=true
ADMIN_ALERT_EMAIL=capstonespeakreadyai@gmail.com

# Docker build control. Leave true to include the local ML runtime used by
# question recommendation and trained local reranking.
INSTALL_PYTHON_ML_DEPS=true

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=capstonespeakreadyai@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

# Gmail SMTP example for password reset and recovery-code emails:
# Some hosts block outbound SMTP ports 25, 465, and 587. If yours does, use an
# HTTPS/API mail provider for production password reset emails.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=yourgmail@gmail.com
# MAIL_PASSWORD="your-google-app-password"
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=yourgmail@gmail.com
# MAIL_FROM_NAME="${APP_NAME}"

# Brevo API password reset and recovery-code email option:
# Create a free Brevo account, verify your sender, generate an API key, then set:
# BREVO_API_KEY=
# MAIL_FROM_ADDRESS=your_verified_sender@example.com
# MAIL_FROM_NAME="${APP_NAME}"
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_API_TIMEOUT=15

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://speakreadyai.online/auth/google/callback
GOOGLE_HTTP_CONNECT_TIMEOUT=5
GOOGLE_HTTP_TIMEOUT=20

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# PWA device push notifications. Generate stable VAPID keys with:
# php artisan webpush:generate-keys
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_SUBJECT="${APP_URL}"
WEBPUSH_AUTO_GENERATE=true

AI_PROVIDER=openai
INTERVIEW_CHATBOT_DEFAULT_PROVIDER=openai
AI_DEFAULT_PROVIDER_PRIORITY=openai,gemini,groq,cohere
INTERVIEW_CHATBOT_PROVIDER_PRIORITY=openai,gemini,groq,cohere
AI_FEEDBACK_PROVIDER_PRIORITY=openai,gemini,groq,cohere
AI_ATTACHMENT_EXTRACTION_PROVIDER_PRIORITY=openai,gemini

# High-capability stable production defaults as of October 2026. Keep explicit
# model IDs, run the built-in provider comparison, and review vendor deprecations.
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-4-argon
GEMINI_THINKING_LEVEL=high

GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

COHERE_API_KEY=
COHERE_API_URL=https://api.cohere.com/v2/chat
COHERE_MODEL=command-a-plus-05-2026

OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6-astra
OPENAI_REASONING_EFFORT=high

# Server voice can use Gemini, OpenAI, or ElevenLabs. Browser Web Speech APIs remain the
# no-key fallback for voice output.
AI_TTS_ENABLED=false
AI_TTS_PROVIDER=elevenlabs,openai,gemini
AI_TTS_TIMEOUT=30
AI_TTS_ONBOARDING_CACHE_TTL_SECONDS=604800
AI_TTS_ONBOARDING_FAILURE_CACHE_TTL_SECONDS=30
AI_TTS_ONBOARDING_DEADLINE_SECONDS=6
AI_TTS_ONBOARDING_RATE_LIMIT_PER_MINUTE=30
AI_TTS_ONBOARDING_RATE_LIMIT_PER_DAY=120
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Leda
GEMINI_TTS_STYLE="Say in a warm, clear, professional female interviewer voice with natural English pronunciation and medium, measured pacing"
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova
OPENAI_TTS_SPEED=0.90
ELEVENLABS_API_KEY=
# ElevenLabs secret API keys start with "sk_"; API key IDs cannot synthesize speech.
ELEVENLABS_API_URL=https://api.elevenlabs.io/v1
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_TTS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TTS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_TTS_LANGUAGE_CODE=
ELEVENLABS_TTS_STABILITY=0.45
ELEVENLABS_TTS_SIMILARITY_BOOST=0.75
ELEVENLABS_TTS_STYLE=0.15
ELEVENLABS_TTS_SPEED=0.90
ELEVENLABS_TTS_SPEAKER_BOOST=true
# The transcription models are used for Interview and Learning Game recording passes.
AI_TRANSCRIPTION_PROVIDER_PRIORITY=openai,gemini
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
GEMINI_TRANSCRIPTION_MODEL=gemini-4-argon
AI_TRANSCRIPTION_TIMEOUT=90
AI_TRANSCRIPTION_CONNECT_TIMEOUT=10
AI_TRANSCRIPTION_HTTP_ATTEMPTS=3
AI_TRANSCRIPTION_RETRY_DELAY_MS=500
AI_TRANSCRIPTION_TOTAL_TIMEOUT=105
AI_TRANSCRIPTION_FINISH_RECOVERY_TIMEOUT=20
AI_TRANSCRIPTION_LOCAL_FALLBACK_RESERVE_SECONDS=20
AI_TRANSCRIPTION_CHUNKING_STRATEGY=auto
AI_TRANSCRIPTION_GEMINI_MAX_OUTPUT_TOKENS=8192
AI_TRANSCRIPTION_RECORDING_BITRATE=128000
AI_TRANSCRIPTION_CHUNK_MS=8000
AI_TRANSCRIPTION_MOBILE_CHUNK_MS=10000
AI_TRANSCRIPTION_DRAIN_TIMEOUT_MS=20000
AI_TRANSCRIPTION_REQUEST_TIMEOUT_MS=30000
AI_TRANSCRIPTION_FULL_REQUEST_TIMEOUT_MS=120000
AI_TRANSCRIPTION_MAX_IN_FLIGHT=2
AI_TRANSCRIPTION_RATE_LIMIT_COOLDOWN_SECONDS=90
AI_TRANSCRIPTION_PROOF_TTL_SECONDS=1800
FFPROBE_COMMAND=ffprobe

# Shared production gate for every algorithm. These values describe measurable
# validation/evidence checks; they do not guarantee that predictions are correct.
# Values below 95 are raised to 95 by the application.
ALGORITHM_MIN_QUALITY_PERCENT=95
ALGORITHM_MIN_ACCURACY_PERCENT=95
ALGORITHM_MIN_RELIABILITY_PERCENT=95
ALGORITHM_MIN_CONFIDENCE_PERCENT=95
ALGORITHM_MIN_EVIDENCE_COUNT=100

# Optional local speech assessment pipeline.
# Install the local tools first, then set LOCAL_SPEECH_ENABLED=true.
# Supported ASR backends: whisper, faster_whisper, conformer, transformers.
# Supported pronunciation backends: ctc, wav2vec2, hubert, wavlm.
# MFA requires a dictionary and acoustic model. GOP requires LOCAL_GOP_COMMAND
# for true phoneme log-likelihood scoring; ctc_proxy is available as a limited
# transcript-agreement proxy, not a clinical GOP score.
LOCAL_SPEECH_ENABLED=false
LOCAL_SPEECH_PYTHON=/opt/speakready-python/bin/python
LOCAL_SPEECH_SCRIPT=scripts/local_speech_assess.py
LOCAL_SPEECH_TIMEOUT=90
LOCAL_ASR_BACKEND=whisper
LOCAL_ASR_MODEL=base
LOCAL_ASR_DEVICE=auto
LOCAL_PRONUNCIATION_BACKEND=ctc
LOCAL_PRONUNCIATION_MODEL=facebook/wav2vec2-base-960h
LOCAL_ALIGNMENT_BACKEND=mfa
MFA_COMMAND=mfa
MFA_DICTIONARY=
MFA_ACOUSTIC_MODEL=
FFMPEG_COMMAND=ffmpeg
LOCAL_GOP_BACKEND=mfa
LOCAL_GOP_COMMAND=
LOCAL_PRONUNCIATION_REQUIRE_TRUE_GOP=true
LOCAL_SPEECH_MIN_TRANSCRIPT_CONFIDENCE=95
LOCAL_SPEECH_MIN_SCORING_RELIABILITY=95

# Optional trained local feedback model. Train it from reviewed answers with:
# php artisan ai:export-feedback-training
# php artisan ai:train-feedback-model
LOCAL_FEEDBACK_MODEL_ENABLED=true
LOCAL_FEEDBACK_MODEL_PYTHON=/opt/speakready-python/bin/python
LOCAL_FEEDBACK_MODEL_TRAIN_SCRIPT=scripts/train_feedback_model.py
LOCAL_FEEDBACK_MODEL_PREDICT_SCRIPT=scripts/predict_feedback.py
LOCAL_FEEDBACK_MODEL_PATH=storage/app/private/models/feedback/latest/model.json
LOCAL_FEEDBACK_MODEL_TIMEOUT=20
LOCAL_FEEDBACK_MODEL_TRAINING_TIMEOUT=300
LOCAL_FEEDBACK_MODEL_REQUIRE_VALIDATION=true
LOCAL_FEEDBACK_MODEL_VALIDATION_FRACTION=0.20
LOCAL_FEEDBACK_MODEL_MIN_VALIDATION_EXAMPLES=100
LOCAL_FEEDBACK_MODEL_MAX_VALIDATION_MAE=5
LOCAL_FEEDBACK_MODEL_MIN_WITHIN_10_RATE=0.95
LOCAL_FEEDBACK_MODEL_MIN_VALIDATION_SKILL=0.10
LOCAL_FEEDBACK_MODEL_MIN_HUMAN_REVIEWED_RATIO=1.0
LOCAL_FEEDBACK_MODEL_AUTO_TRAIN=false
LOCAL_FEEDBACK_MODEL_AUTO_TRAIN_TIME=02:30
LOCAL_FEEDBACK_MODEL_AUTO_TRAIN_DATASET=normalized/training/feedback_train.jsonl
LOCAL_FEEDBACK_MODEL_AUTO_TRAIN_STATUSES=approved,archived
LOCAL_FEEDBACK_MODEL_AUTO_TRAIN_MIN_EXAMPLES=500
LOCAL_FEEDBACK_MODEL_AUTO_TRAIN_EPOCHS=80

# Optional HR question recommendation pipeline.
# Build the embedding database with:
# php artisan ai:build-question-embedding-index
# Production backend requires sentence-transformers for Sentence-BERT.
QUESTION_RECOMMENDER_ENABLED=true
QUESTION_RECOMMENDER_PYTHON=/opt/speakready-python/bin/python
QUESTION_RECOMMENDER_SCRIPT=scripts/recommend_interview_question.py
QUESTION_RERANK_SCRIPT=scripts/rerank_question_candidates.py
QUESTION_RERANK_SERVER_SCRIPT=scripts/serve_question_reranker.py
QUESTION_RERANK_SERVER_ENABLED=true
QUESTION_RERANK_ENDPOINT=http://127.0.0.1:8765/rerank
QUESTION_RERANK_SERVER_HOST=127.0.0.1
QUESTION_RERANK_SERVER_PORT=8765
QUESTION_RERANK_SERVER_TIMEOUT=3
QUESTION_EMBEDDING_INDEX_PATH=storage/app/private/datasets/embeddings/questions/latest/question_embeddings.json
QUESTION_EMBEDDING_BACKEND=sentence-bert
QUESTION_EMBEDDING_BUILD_TIMEOUT=3600
QUESTION_RECOMMENDER_TIMEOUT=120
QUESTION_TRAINED_MODEL_ENABLED=true
QUESTION_TRAINED_MODEL_PATH=storage/app/private/models/questions/latest/trained_model
QUESTION_TRAINED_MODEL_LABEL_MAP_PATH=storage/app/private/models/questions/latest/trained_model/speakready_question_labels.json
QUESTION_TRAINED_MODEL_VALIDATION_PATH=storage/app/private/models/questions/latest/trained_model/validation_metrics.json
QUESTION_TRAINED_MODEL_REQUIRE_VALIDATION=true
QUESTION_TRAINED_MODEL_MIN_EVALUATION_EXAMPLES=200
QUESTION_TRAINED_MODEL_MIN_PRECISION_AT_5=0.95
QUESTION_TRAINED_MODEL_TIMEOUT=120
QUESTION_TRAINED_MODEL_PROCESS_FALLBACK=false
QUESTION_AI_PROVIDER_RERANK_ENABLED=true
QUESTION_AI_PROVIDER_RERANK_TIMEOUT=8
QUESTION_AI_PROVIDER_RERANK_ATTEMPTS=1
QUESTION_AI_PROVIDER_RERANK_CANDIDATE_LIMIT=18
QUESTION_AI_PROVIDER_RERANK_PRIORITY=openai,gemini,groq,cohere
QUESTION_RECOMMENDER_CANDIDATE_POOL_LIMIT=120
QUESTION_RECOMMENDER_CANDIDATE_POOL_MULTIPLIER=8
QUESTION_GENERATION_RAG_ENABLED=true
QUESTION_GENERATION_RAG_EXAMPLE_LIMIT=6

# After the selected/evaluated provider, the app tries hosted AI fallbacks in
# this order. If all are unavailable, it uses local evidence scoring.
# AI_FEEDBACK_PROVIDER_PRIORITY=openai,gemini,groq,cohere
OPENAI_FEEDBACK_MODEL=gpt-6-astra
OPENAI_JSON_MODE_FALLBACK=false
AI_FEEDBACK_TIMEOUT=45
AI_FEEDBACK_DEADLINE_SECONDS=150
AI_FEEDBACK_MAX_PROVIDERS=4
AI_FEEDBACK_ATTEMPTS=2
AI_FEEDBACK_HTTP_ATTEMPTS=2
AI_FEEDBACK_RETRY_DELAY_MS=250
# Feedback output scales automatically by answer count when omitted. Set an
# explicit ceiling for predictable production capacity on long (up to 20-answer) reports.
AI_FEEDBACK_MAX_OUTPUT_TOKENS=32768
AI_FEEDBACK_FINALIZATION_TIMEOUT=30
AI_FEEDBACK_FINALIZATION_DEADLINE_SECONDS=90
AI_FEEDBACK_FINALIZATION_ATTEMPTS=2
AI_FEEDBACK_FINALIZATION_HTTP_ATTEMPTS=2
AI_FEEDBACK_FINALIZATION_RETRY_DELAY_MS=250
AI_FEEDBACK_REVIEW_REFRESH_TIMEOUT=30
AI_FEEDBACK_REVIEW_REFRESH_DEADLINE_SECONDS=60
AI_FEEDBACK_REVIEW_REFRESH_ATTEMPTS=2
AI_FEEDBACK_REVIEW_REFRESH_HTTP_ATTEMPTS=2
AI_FEEDBACK_REVIEW_REFRESH_RETRY_DELAY_MS=250
AI_FEEDBACK_REVIEW_RETRY_COOLDOWN_MINUTES=10
AI_GAME_FEEDBACK_TIMEOUT=30
AI_GAME_FEEDBACK_DEADLINE_SECONDS=90
AI_GAME_FEEDBACK_ATTEMPTS=2
AI_GAME_FEEDBACK_HTTP_ATTEMPTS=2
AI_GAME_FEEDBACK_RETRY_DELAY_MS=250
# Final persistence gate for scoreable Detailed Review answers. Values below 95 are raised to 95.
AI_FEEDBACK_REVIEW_MIN_RELIABILITY_PERCENT=95
AI_PROVIDER_SMOKE_TIMEOUT=20
AI_PROVIDER_SMOKE_DEADLINE_SECONDS=45
AI_VOICE_ANALYSIS_TIMEOUT=12
AI_VOICE_ANALYSIS_MAX_PROVIDERS=2
AI_VOICE_ANALYSIS_HTTP_ATTEMPTS=1
AI_PROVIDER_TIMEOUT=45
AI_PROVIDER_CONNECT_TIMEOUT=5
AI_PROVIDER_RETRIES=2
AI_PROVIDER_RETRY_DELAY_MS=250
AI_PROVIDER_MAX_RETRY_DELAY_MS=5000
# Provider promotion is fail-closed. These are measured validation gates, not a
# promise that probabilistic model output is factually accurate 95-100% of the time.
AI_PROVIDER_MIN_QUALITY_PERCENT=95
AI_PROVIDER_MIN_ACCURACY_PERCENT=95
AI_PROVIDER_MIN_RELIABILITY_PERCENT=95
AI_PROVIDER_MIN_SCHEMA_PERCENT=100
AI_PROVIDER_MIN_SAFETY_PERCENT=100
AI_PROVIDER_MIN_SUCCESS_RATE_PERCENT=95
AI_PROVIDER_MIN_BENCHMARK_SAMPLES=3
AI_PROVIDER_CIRCUIT_BREAKER_ENABLED=true
AI_PROVIDER_CIRCUIT_BREAKER_IN_TESTS=false
AI_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
AI_PROVIDER_CIRCUIT_COOLDOWN_SECONDS=120
AI_PROVIDER_ALLOW_CUSTOM_ENDPOINTS=false
AI_PROVIDER_MAX_RESPONSE_BYTES=1048576
AI_PROVIDER_JSON_MODE_FALLBACK=false
AI_CHALLENGE_GENERATION_TIMEOUT=8
AI_CHALLENGE_GENERATION_ATTEMPTS=1
AI_CHALLENGE_GENERATION_MAX_PROVIDERS=1
AI_MODULE_GENERATION_TIMEOUT=8
AI_MODULE_GENERATION_ATTEMPTS=1
AI_MODULE_GENERATION_MAX_PROVIDERS=1
AI_JSON_MAX_TOKENS=4096
AI_CHAT_MAX_TOKENS=1000
AI_CHAT_TEMPERATURE=0.2
AI_COACH_CHAT_TIMEOUT=20
AI_COACH_CHAT_ATTEMPTS=1
AI_COACH_CHAT_MAX_PROVIDERS=3
AI_COACH_MIN_RELIABILITY_PERCENT=95
