APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Render production notes:
# Set APP_ENV=production, APP_DEBUG=false, and APP_URL to your public URL
# such as https://your-service.onrender.com or your custom domain.
# If APP_URL is missing or accidentally left as localhost, the app falls back
# to Render's RENDER_EXTERNAL_URL at runtime.

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# Render Postgres production example:
# Set DATABASE_URL to the full Internal Database URL from the Render database
# when the web service and database are in the same Render account and region.
# If they are not in the same region, use the full External Database URL instead.
# Do not set DB_HOST to only a partial Render host such as dpg-...-a.
# DB_CONNECTION=pgsql
# DATABASE_URL=postgresql://user:password@host:5432/database
# DB_SSLMODE=require
# RENDER_POSTGRES_REGION=singapore

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# For Render production HTTPS cookies:
# SESSION_SECURE_COOKIE=true

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Gmail SMTP example for password reset emails:
# Gmail SMTP works on paid Render instances. Render Free web services block
# outbound SMTP ports 25, 465, and 587, so use a paid instance or an HTTPS/API
# mail provider for production password reset emails.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=yourgmail@gmail.com
# MAIL_PASSWORD="your-google-app-password"
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=yourgmail@gmail.com
# MAIL_FROM_NAME="${APP_NAME}"

# Render Free password reset email option:
# Create a free Brevo account, verify your sender, generate an API key, then set:
# BREVO_API_KEY=
# MAIL_FROM_ADDRESS=your_verified_sender@example.com
# MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

AI_PROVIDER=huggingface
INTERVIEW_CHATBOT_DEFAULT_PROVIDER=huggingface
AI_DEFAULT_PROVIDER_PRIORITY=huggingface,gemini,groq,openrouter,cohere,openai
INTERVIEW_CHATBOT_PROVIDER_PRIORITY=huggingface,gemini,groq,openrouter,cohere,openai
AI_FEEDBACK_PROVIDER_PRIORITY=huggingface,gemini,groq,openrouter,cohere,openai
AI_ATTACHMENT_EXTRACTION_PROVIDER_PRIORITY=gemini

HUGGINGFACE_API_KEY=
HUGGINGFACE_API_URL=https://router.huggingface.co/v1
HUGGINGFACE_MODEL=openai/gpt-oss-120b:cerebras

GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.6-flash

GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free

COHERE_API_KEY=
COHERE_API_URL=https://api.cohere.com/v2/chat
COHERE_MODEL=command-r7b-12-2024

OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Server voice can use Gemini, OpenAI, or ElevenLabs. Browser Web Speech APIs remain the
# no-key fallback for voice output.
AI_TTS_ENABLED=false
AI_TTS_PROVIDER=gemini
AI_TTS_TIMEOUT=30
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore
GEMINI_TTS_STYLE="Say in a warm, clear, professional interviewer voice with natural Philippine English pronunciation and steady pacing"
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_TTS_SPEED=0.95
ELEVENLABS_API_KEY=
# ElevenLabs secret API keys start with "sk_"; API key IDs cannot synthesize speech.
ELEVENLABS_API_URL=https://api.elevenlabs.io/v1
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_TTS_VOICE_ID=XrExE9yKIg1WjnnlVkGX
ELEVENLABS_TTS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_TTS_LANGUAGE_CODE=
ELEVENLABS_TTS_STABILITY=0.45
ELEVENLABS_TTS_SIMILARITY_BOOST=0.75
ELEVENLABS_TTS_STYLE=0.15
ELEVENLABS_TTS_SPEAKER_BOOST=true
# OPENAI_TRANSCRIPTION_MODEL is used for live interview speech-to-text chunks.
AI_TRANSCRIPTION_PROVIDER_PRIORITY=openai,gemini
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
GEMINI_TRANSCRIPTION_MODEL="${GEMINI_MODEL}"
AI_TRANSCRIPTION_TIMEOUT=45
AI_TRANSCRIPTION_CHUNK_MS=4000
AI_TRANSCRIPTION_MOBILE_CHUNK_MS=5000
AI_TRANSCRIPTION_DRAIN_TIMEOUT_MS=20000
AI_TRANSCRIPTION_REQUEST_TIMEOUT_MS=30000
AI_TRANSCRIPTION_MAX_IN_FLIGHT=2
AI_TRANSCRIPTION_RATE_LIMIT_COOLDOWN_SECONDS=90

# Optional local speech assessment pipeline.
# Install the local tools first, then set LOCAL_SPEECH_ENABLED=true.
# Supported ASR backends: whisper, faster_whisper, conformer, transformers.
# Supported pronunciation backends: ctc, wav2vec2, hubert, wavlm.
# MFA requires a dictionary and acoustic model. GOP requires LOCAL_GOP_COMMAND
# for true phoneme log-likelihood scoring; ctc_proxy is available as a limited
# transcript-agreement proxy, not a clinical GOP score.
LOCAL_SPEECH_ENABLED=false
LOCAL_SPEECH_PYTHON=python
LOCAL_SPEECH_SCRIPT=scripts/local_speech_assess.py
LOCAL_SPEECH_TIMEOUT=90
LOCAL_ASR_BACKEND=whisper
LOCAL_ASR_MODEL=base
LOCAL_ASR_DEVICE=auto
LOCAL_PRONUNCIATION_BACKEND=ctc
LOCAL_PRONUNCIATION_MODEL=facebook/wav2vec2-base-960h
LOCAL_ALIGNMENT_BACKEND=mfa
MFA_COMMAND=mfa
MFA_DICTIONARY=
MFA_ACOUSTIC_MODEL=
FFMPEG_COMMAND=ffmpeg
LOCAL_GOP_BACKEND=mfa
LOCAL_GOP_COMMAND=

# Optional trained local feedback model. Train it from reviewed answers with:
# php artisan ai:export-feedback-training
# php artisan ai:train-feedback-model
LOCAL_FEEDBACK_MODEL_ENABLED=false
LOCAL_FEEDBACK_MODEL_PYTHON=python
LOCAL_FEEDBACK_MODEL_TRAIN_SCRIPT=scripts/train_feedback_model.py
LOCAL_FEEDBACK_MODEL_PREDICT_SCRIPT=scripts/predict_feedback.py
LOCAL_FEEDBACK_MODEL_PATH=storage/app/private/models/feedback/latest/model.json
LOCAL_FEEDBACK_MODEL_TIMEOUT=20
LOCAL_FEEDBACK_MODEL_TRAINING_TIMEOUT=300
LOCAL_FEEDBACK_MODEL_AUTO_TRAIN=false
LOCAL_FEEDBACK_MODEL_AUTO_TRAIN_TIME=02:30
LOCAL_FEEDBACK_MODEL_AUTO_TRAIN_DATASET=normalized/training/feedback_train.jsonl
LOCAL_FEEDBACK_MODEL_AUTO_TRAIN_STATUSES=approved,archived
LOCAL_FEEDBACK_MODEL_AUTO_TRAIN_MIN_EXAMPLES=100
LOCAL_FEEDBACK_MODEL_AUTO_TRAIN_EPOCHS=80

# The app tries hosted AI providers in this order for final interview feedback.
# If they are unavailable, it completes the report with local evidence scoring.
# AI_FEEDBACK_PROVIDER_PRIORITY=huggingface,gemini,groq,openrouter,cohere,openai
OPENAI_FEEDBACK_MODEL=gpt-4o-mini
OPENAI_JSON_MODE_FALLBACK=true
AI_FEEDBACK_TIMEOUT=15
AI_FEEDBACK_DEADLINE_SECONDS=25
AI_FEEDBACK_MAX_PROVIDERS=6
AI_FEEDBACK_ATTEMPTS=1
AI_FEEDBACK_HTTP_ATTEMPTS=1
AI_FEEDBACK_RETRY_DELAY_MS=200
AI_VOICE_ANALYSIS_TIMEOUT=12
AI_VOICE_ANALYSIS_MAX_PROVIDERS=2
AI_VOICE_ANALYSIS_HTTP_ATTEMPTS=1
AI_PROVIDER_TIMEOUT=45
AI_PROVIDER_CONNECT_TIMEOUT=5
AI_PROVIDER_RETRIES=2
AI_PROVIDER_RETRY_DELAY_MS=250
AI_JSON_MAX_TOKENS=4096
AI_CHAT_MAX_TOKENS=1000
